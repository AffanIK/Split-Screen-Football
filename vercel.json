{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "./", "framework": "vite" },
    "game": { "root": "game/", "entrypoint": "server.js" }
  },
  "rewrites": [
    { "source": "/ws/(.*)", "destination": { "service": "game" } },
    { "source": "/health", "destination": { "service": "game" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}