{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/ws/(.*)", "destination": "/api/ws" },
    { "source": "/health", "destination": "/api/ws" }
  ],
  "functions": {
    "api/ws.js": { "maxDuration": 300 }
  }
}
