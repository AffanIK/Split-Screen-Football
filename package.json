{
  "name": "split-screen-football",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c green,blue \"vite\" \"tsx watch src/server/index.ts\"",
    "server": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "vite build",
    "build:api": "esbuild src/vercel/ws.ts --bundle --platform=node --format=esm --target=node20 --external:ws --outfile=api/ws.js --banner:js=\"// Generated from src/vercel/ws.ts by npm run build:api. Do not edit.\"",
    "test": "vitest run",
    "soak": "tsx scripts/soak.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "worker:dev": "wrangler dev --port 8787",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "tsx": "^4.23.15",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.0"
  }
}
